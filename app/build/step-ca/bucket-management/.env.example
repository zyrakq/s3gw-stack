# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example, bucket-management/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=s3gw

# Docker image
IMAGE=cloud37io/s3-encryption-gateway:0.11.10

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

## s3-gateway
BACKEND_ACCESS_KEY=backenduser
BACKEND_SECRET_KEY=backendpass
BACKEND_ENDPOINT=https://your-s3.example.com
BACKEND_REGION=us-east-1
BACKEND_USE_PATH_STYLE=true
BACKEND_USE_SSL=true
BACKEND_TLS_INSECURE_SKIP_VERIFY=false

# openssl rand -hex 32
ENCRYPTION_PASSWORD=b774716f8e3bda974bec33291fab64dfc952ddeb2ace1290eb3ad74896431c59

KEY_MANAGER_ENABLED=true
KEY_MANAGER_PROVIDER=self_contained
SELF_CONTAINED_TYPE=aes
# openssl rand -base64 32
SELF_CONTAINED_AES_KEYS=1=base64:WJHE8s4aWqy8SZJNok+kd2atyBa/25IRiqcOF6I2t5g=

# openssl rand -hex 16
GW_CRED_0_ACCESS_KEY=5b4eb8c0464607586e92871262a6bb1b
# openssl rand -hex 32
GW_CRED_0_SECRET_KEY=9009d23d57be40410d3374dabbdf1f2a632160a7b9306cb902926dd5c2d23924

AUTH_ALLOW_LEGACY_SIGNATURE_V2=true
# === STEP CA CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=8080
VIRTUAL_HOST=s3gw.local

# Step CA SSL certificate domain
LETSENCRYPT_HOST=s3gw.local

# Email for Step CA certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com
# Bucket Management

# IMAGE=cloud37io/s3-encryption-gateway:0.12.0-rc2

GW_CRED_0_PERMISSIONS=rw
GW_CRED_0_BUCKET_PERMISSIONS=create,delete
# GW_CRED_0_BUCKETS=app-*

ALLOW_BUCKET_CREATION=true